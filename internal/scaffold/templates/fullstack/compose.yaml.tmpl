services:
  postgres:
    image: pgvector/pgvector:pg16
    environment:
      POSTGRES_DB: [[ .AppName ]]_dev
      POSTGRES_USER: eden
      POSTGRES_PASSWORD: eden_dev
    ports:
      - "5434:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  nats:
    image: nats:latest
    ports:
      - "4223:4222"

  minio:
    image: minio/minio:latest
    command: server /data --console-address ":9003"
    environment:
      MINIO_ROOT_USER: minio
      MINIO_ROOT_PASSWORD: minio_dev
    ports:
      - "9002:9000"
      - "9003:9001"
    volumes:
      - minio_data:/data

volumes:
  postgres_data:
  minio_data:
